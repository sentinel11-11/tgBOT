# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Куда слать уведомления о новых кандидатах (id пользователя, id группы или @channel)
MANAGER_CHAT_ID=123456789

# SOCKS5/HTTP прокси. Пусто или не задано — подключение напрямую.
# PROXY_URL=socks5://127.0.0.1:1082

# Google Sheets (опционально)
# GOOGLE_SHEETS_ENABLED=true
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890
# GOOGLE_WORKSHEET=Кандидаты

# Путь к конфигу (по умолчанию config.yaml)
# CONFIG_PATH=config.yaml

# Уровень логирования
# LOG_LEVEL=INFO
