[Unit]
Description=Telegram bot for candidate screening
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/opt/tgbot
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/tgbot/.env
ExecStart=/opt/tgbot/.venv/bin/python -m bot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Немного изоляции
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tgbot/data /opt/tgbot/logs

[Install]
WantedBy=multi-user.target
